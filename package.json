{
  "name": "navori-dashboard-starter",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Navori"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cleanup": "node scripts/cleanup.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "cpd": "jscpd src",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.104",
    "@apollo/client": "^4.3.0",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.74.0",
    "@shadcn/helpers": "^0.2.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "ai": "^7.0.101",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^17.0.2",
    "input-otp": "^1.5.0",
    "kbar": "^1.0.0",
    "match-sorter": "^8.3.0",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.1",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.2",
    "react-resizable-panels": "^4.12.4",
    "react-responsive": "^10.0.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "sort-by": "^1.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sort-by": "^1.2.3",
    "@types/uuid": "^11.0.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jscpd": "^5.2.0",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "sharp": "^0.35.4"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
